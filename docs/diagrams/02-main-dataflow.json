{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "主链路：抓取、缓存、Markdown 投影、可选摘要",
    "locale": "zh-CN",
    "output": "02-main-dataflow.html",
    "quality_profile": "showcase",
    "viewBox": [1280, 720],
    "views": [
      {
        "id": "hotPath",
        "label": "热路径",
        "focus": ["srcUrl", "scrapeWx", "useFetch", "tblArticle", "projRead", "outMd"],
        "note": "URL 进库后，阅读 Markdown 从缓存 HTML 现算；导出默认无图。"
      },
      {
        "id": "cacheKeys",
        "label": "缓存键",
        "focus": ["useFetch", "tblArticle", "tblSum"],
        "note": "文章命中比 URL；摘要是否过期比正文 content_hash。"
      },
      {
        "id": "optionalOut",
        "label": "可选产出",
        "focus": ["projRead", "llmDs", "tblSum", "outMd"],
        "note": "摘要走同一投影的 SummarySourceRenderer；不是必经之路。"
      }
    ]
  },
  "stages": [
    { "label": "来源" },
    { "label": "抓取" },
    { "label": "缓存" },
    { "label": "阅读投影" },
    { "label": "产出" }
  ],
  "nodes": [
    { "id": "srcUrl", "type": "external", "label": "公众号 URL", "stage": 0, "row": 1, "tag": "仅微信" },
    { "id": "scrapeWx", "type": "security", "label": "WechatHttpxScraper", "stage": 1, "row": 0, "tag": "SSRF" },
    { "id": "useFetch", "type": "backend", "label": "FetchArticleUseCase", "stage": 1, "row": 2 },
    { "id": "tblArticle", "type": "database", "label": "articles", "stage": 2, "row": 1, "tag": "SQLite" },
    { "id": "tblSum", "type": "database", "label": "summaries", "stage": 2, "row": 3 },
    { "id": "projRead", "type": "backend", "label": "阅读投影", "stage": 3, "row": 1, "tag": "不落库" },
    { "id": "outMd", "type": "frontend", "label": "阅读 / 导出", "stage": 4, "row": 0, "tag": "MD 无图" },
    { "id": "llmDs", "type": "cloud", "label": "DeepSeek", "stage": 4, "row": 2, "tag": "四字段" }
  ],
  "flows": [
    { "id": "htmlIn", "from": "srcUrl", "to": "scrapeWx", "label": "公众号 HTML", "classification": "untrusted_web_content", "variant": "security" },
    { "id": "scrapeFetch", "from": "scrapeWx", "to": "useFetch", "label": "清洗后文章", "classification": "Article", "variant": "emphasis" },
    { "id": "persistRow", "from": "useFetch", "to": "tblArticle", "label": "save / get_by_url", "classification": "articles 行", "variant": "emphasis" },
    { "id": "projectHtml", "from": "tblArticle", "to": "projRead", "label": "content_html", "classification": "读时现算", "variant": "emphasis" },
    { "id": "emitMd", "from": "projRead", "to": "outMd", "label": "Markdown 投影", "classification": "对外契约", "variant": "emphasis" },
    { "id": "sumSrc", "from": "projRead", "to": "llmDs", "label": "摘要源 Markdown", "classification": "模型输入", "variant": "dashed" },
    { "id": "sumOut", "from": "llmDs", "to": "tblSum", "label": "四字段 JSON", "classification": "绑定 content_hash", "variant": "dashed" }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "一条主链路",
      "items": ["抓取 → SQLite → 读时投影 Markdown；导出默认无图，分页不落库"]
    },
    {
      "dot": "cyan",
      "title": "两种命中",
      "items": ["文章比 URL；摘要是否过期比 content_hash"]
    },
    {
      "dot": "orange",
      "title": "摘要是旁路",
      "items": ["DeepSeek 输入与阅读页同源投影，但不是必经之路"]
    }
  ]
}
