      },
      {
        "id": "optional-out",
        "label": "可选产出",
        "focus": ["projector", "deepseek", "summaries", "markdown"],
        "note": "摘要走同一投影的 SummarySourceRenderer；导出复用同一套 Markdown/HTML 渲染。"
      }
    ]
  },
  "stages": [
    { "label": "来源" },
    { "label": "抓取" },
    { "label": "缓存" },
    { "label": "阅读投影" },
    { "label": "产出" }
  ],
  "nodes": [
    { "id": "wechat", "type": "external", "label": "公众号 URL", "sublabel": "mp.weixin.qq.com", "stage": 0, "row": 1, "tag": "唯一来源" },
    { "id": "scraper", "type": "security", "label": "WechatHttpxScraper", "sublabel": "SSRF / 清洗", "stage": 1, "row": 0, "tag": "HTML" },
    { "id": "fetch", "type": "backend", "label": "FetchArticleUseCase", "sublabel": "URL 缓存命中", "stage": 1, "row": 2 },
    { "id": "sqlite", "type": "database", "label": "articles", "sublabel": "HTML + content_hash", "stage": 2, "row": 1, "tag": "SQLite" },
    { "id": "summaries", "type": "database", "label": "summaries", "sublabel": "article_id + hash", "stage": 2, "row": 3 },
    { "id": "projector", "type": "backend", "label": "阅读投影", "sublabel": "HTML → blocks", "stage": 3, "row": 1, "tag": "不落库" },
    { "id": "markdown", "type": "frontend", "label": "阅读 / 导出", "sublabel": "Markdown / HTML", "stage": 4, "row": 0 },
    { "id": "deepseek", "type": "cloud", "label": "DeepSeek", "sublabel": "四字段 JSON", "stage": 4, "row": 2 }
  ],
  "flows": [
    { "id": "html-in", "from": "wechat", "to": "scraper", "label": "公众号 HTML", "classification": "untrusted_web_content", "variant": "security" },
    { "id": "scrape-fetch", "from": "scraper", "to": "fetch", "label": "清洗后文章", "classification": "Article", "variant": "emphasis" },
    { "id": "persist", "from": "fetch", "to": "sqlite", "label": "save / get_by_url", "classification": "articles 行", "variant": "emphasis" },
    { "id": "project", "from": "sqlite", "to": "projector", "label": "content_html", "classification": "读时现算", "variant": "emphasis" },
    { "id": "read-page", "from": "projector", "to": "markdown", "label": "分页 Markdown", "classification": "对外契约", "variant": "emphasis" },
    { "id": "summary-src", "from": "projector", "to": "deepseek", "label": "摘要源 Markdown", "classification": "模型输入", "variant": "dashed" },
    { "id": "summary-out", "from": "deepseek", "to": "summaries", "label": "四字段 JSON", "classification": "绑定 content_hash", "variant": "dashed" }
  ],
  "cards": [
