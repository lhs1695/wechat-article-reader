{
  "schema_version": 1,
  "diagram_type": "workflow",
  "meta": {
    "title": "阅读投影：分块、按节切片、软分页",
    "locale": "zh-CN",
    "output": "05-reading-projection.html",
    "quality_profile": "showcase",
    "viewBox": [1280, 720],
    "views": [
      {
        "id": "projectView",
        "label": "投影",
        "focus": ["htmlCache", "projWalk", "blockList", "tocSecs"],
        "note": "清洗后的 HTML 按文档顺序拆块；sections 由 heading 推导。"
      },
      {
        "id": "pageView",
        "label": "成页",
        "focus": ["blockList", "softPage", "mdPage"],
        "note": "不传 section 且全文不超过 max_chars 则一次返回；传 section 只切该节。"
      },
      {
        "id": "overflowView",
        "label": "超大块",
        "focus": ["softPage", "errLarge"],
        "note": "单块超过 20000 才 page_too_large；Markdown 页默认无图。"
      }
    ]
  },
  "lanes": [
    { "id": "source", "label": "缓存 HTML" },
    { "id": "project", "label": "投影" },
    { "id": "page", "label": "分页" },
    { "id": "out", "label": "对外契约" },
    { "id": "exceptions", "label": "硬顶", "variant": "exception" }
  ],
  "phases": [
    { "id": "clean", "label": "读缓存", "fromCol": 0, "toCol": 1 },
    { "id": "split", "label": "分块 + 目录", "fromCol": 2, "toCol": 3, "variant": "emphasis" },
    { "id": "emit", "label": "成页", "fromCol": 4, "toCol": 5 }
  ],
  "groups": [
    { "id": "runtimeOnly", "label": "读时现算，不入库", "lane": "project", "fromCol": 2, "toCol": 3, "variant": "emphasis" }
  ],
  "mainPath": ["htmlCache", "projWalk", "blockList", "tocSecs", "softPage", "mdPage"],
  "nodes": [
    { "id": "htmlCache", "lane": "source", "col": 0, "type": "database", "label": "content_html" },
    { "id": "projWalk", "lane": "source", "col": 1, "type": "backend", "label": "Projector" },
    { "id": "blockList", "lane": "project", "col": 2, "type": "backend", "label": "blocks" },
    { "id": "tocSecs", "lane": "project", "col": 3, "type": "backend", "label": "sections" },
    { "id": "softPage", "lane": "page", "col": 4, "type": "backend", "label": "软分页" },
    { "id": "mdPage", "lane": "out", "col": 5, "type": "frontend", "label": "Markdown 页" },
    { "id": "errLarge", "lane": "exceptions", "col": 5, "type": "security", "label": "page_too_large" }
  ],
  "edges": [
    { "id": "loadHtml", "from": "htmlCache", "to": "projWalk", "label": "project", "variant": "emphasis" },
    { "id": "toBlocks", "from": "projWalk", "to": "blockList", "variant": "emphasis" },
    { "id": "toSecs", "from": "blockList", "to": "tocSecs", "label": "由 heading 推导", "labelDy": -22 },
    { "id": "toPage", "from": "tocSecs", "to": "softPage", "variant": "emphasis" },
    { "id": "toMd", "from": "softPage", "to": "mdPage", "variant": "emphasis" },
    { "id": "overflow", "from": "softPage", "to": "errLarge", "variant": "security", "role": "error" }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "公开承诺",
      "items": ["对外只有 Markdown 页、cursor、可选 section；block id 不对外"]
    },
    {
      "dot": "cyan",
      "title": "目录与跳章",
      "items": ["默认 toc_level=2；传 section 只返回该节，节尾丢掉模板装饰"]
    },
    {
      "dot": "orange",
      "title": "软边界",
      "items": ["列表尽量整组；CLI / Web / MCP 阅读页默认不含图"]
    }
  ]
}
