# DeepSeek 摘要（可选；未配置时仍可抓取、阅读和导出正文）
WECHAT_ARTICLE_READER_DEEPSEEK__API_KEY=your-deepseek-api-key-here
WECHAT_ARTICLE_READER_DEEPSEEK__MODEL=deepseek-v4-flash
WECHAT_ARTICLE_READER_DEEPSEEK__TIMEOUT=60
WECHAT_ARTICLE_READER_DEEPSEEK__MAX_OUTPUT_TOKENS=1200
WECHAT_ARTICLE_READER_DEEPSEEK__MAX_INPUT_CHARS=50000
# 为推理模型预留的 reasoning token；与最终 JSON 输出上限分开计算
WECHAT_ARTICLE_READER_DEEPSEEK__REASONING_TOKEN_BUDGET=4800

# 微信公众号 HTTPX 抓取器
WECHAT_ARTICLE_READER_SCRAPER__TIMEOUT=30
WECHAT_ARTICLE_READER_SCRAPER__MAX_RETRIES=3
WECHAT_ARTICLE_READER_SCRAPER__MAX_RESPONSE_BYTES=5242880
WECHAT_ARTICLE_READER_SCRAPER__MAX_CONTENT_CHARS=500000
# 同一抓取器实例的最小请求间隔；429/5xx 重试等待上限（秒）
WECHAT_ARTICLE_READER_SCRAPER__MIN_REQUEST_INTERVAL_SECONDS=0.5
WECHAT_ARTICLE_READER_SCRAPER__MAX_RETRY_DELAY_SECONDS=10

# 本地数据与导出
WECHAT_ARTICLE_READER_EXPORT__DEFAULT_OUTPUT_DIR=./output
WECHAT_ARTICLE_READER_RUNTIME_DIR=./.runtime
